rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function ehDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Faixa de preço do produto. `valorMaxCentavos` É o gatilho do alerta — não
    // existe campo derivado para o coletor recalcular e corrigir a cada ciclo.
    // O que o cliente grava é o que vale, e por isso a validação aqui é a única
    // linha de defesa.
    //
    // O MÁXIMO é obrigatório: sem ele não há gatilho e o produto nunca
    // notificaria — cadastrar assim seria cadastrar um monitor que não monitora.
    //
    // O MÍNIMO é opcional (`null`). Ele não participa da decisão de alerta, é só
    // a referência de "preço ideal" do usuário, e exigir um número que não faz
    // nada é atrito à toa. Quando existe, precisa ser <= máximo: faixa invertida
    // na tela é pior que faixa ausente.
    function produtoValido() {
      let d = request.resource.data;
      return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
          && d.valorMaxCentavos is int && d.valorMaxCentavos > 0
          && (d.valorMinCentavos == null
              || (d.valorMinCentavos is int
                  && d.valorMinCentavos > 0
                  && d.valorMinCentavos <= d.valorMaxCentavos))
          && d.ativo is bool;
    }

    function camposDoCliente() {
      return ['nome', 'valorMinCentavos', 'valorMaxCentavos', 'ativo'];
    }

    // Única escrita em fonte permitida ao cliente: devolvê-la à fila de
    // validação. Cobre os dois casos do usuário — "tentar de novo" e "editar o
    // link" — porque ambos terminam no mesmo lugar: status pendente, contadores
    // zerados, e o coletor decidindo se a URL presta.
    //
    // O que continua proibido: promover para 'ok', mexer em ultimoPrecoCentavos,
    // ultimaColetaEm ou em qualquer campo que seja território do coletor.
    function ehReenfileiramentoDeFonte() {
      let antes = resource.data;
      let depois = request.resource.data;
      return depois.status == 'pendente'
          && depois.motivoInvalida == null
          && depois.falhasSeguidas == 0
          && depois.comErro == false
          && depois.url is string && depois.url.matches('https://.*')
          && depois.loja is string && depois.loja.size() > 0
          && depois.diff(antes).affectedKeys().hasOnly(
               ['status', 'motivoInvalida', 'falhasSeguidas', 'comErro',
                'url', 'loja']);
    }

    match /usuarios/{uid} {

      match /produtos/{produtoId} {
        allow read, delete: if ehDono(uid);
        allow create: if ehDono(uid) && produtoValido()
                      && request.resource.data.estado == 'ACIMA'
                      && request.resource.data.ultimoAlertaEm == null;
        allow update: if ehDono(uid) && produtoValido()
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(camposDoCliente());

        match /fontes/{fonteId} {
          allow read, delete: if ehDono(uid);
          // o cliente só cria fonte em estado pendente; quem promove é o coletor
          allow create: if ehDono(uid)
                        && request.resource.data.status == 'pendente'
                        && request.resource.data.url is string
                        && request.resource.data.url.matches('https://.*')
                        && request.resource.data.loja is string
                        && request.resource.data.falhasSeguidas == 0
                        && request.resource.data.comErro == false;
          allow update: if ehDono(uid) && ehReenfileiramentoDeFonte();
        }

        // Ler e APAGAR são do dono; criar e alterar são só do coletor.
        // O delete existe porque o Firestore não faz cascata: sem ele, excluir
        // um produto deixaria histórico órfão para sempre. Poder apagar o
        // próprio histórico não permite forjá-lo, que é o que importa proteger.
        match /historico/{docId} {
          allow read, delete: if ehDono(uid);
          allow create, update: if false;
        }
        match /diario/{docId} {
          allow read, delete: if ehDono(uid);
          allow create, update: if false;
        }
      }

      match /sistema/{docId} { allow read: if ehDono(uid); allow write: if false; }
    }

    // Catálogo: global e compartilhado. Qualquer usuário autenticado lê para
    // navegar e favoritar; escrever é exclusividade do coletor (Admin SDK).
    // Não há dado pessoal aqui — é o que a loja já publica na vitrine.
    match /catalogo/{loja} {
      allow read: if request.auth != null;
      allow write: if false;

      match /{documento=**} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
